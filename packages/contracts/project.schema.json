{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mskuracing.example/schemas/project-2.0.0.json",
  "title": "MSKU Racing Dynamics Studio four-corner project",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projectId", "name", "description", "createdAt", "updatedAt", "dataClassification", "modelStatus", "units", "coordinateSystem", "activeCornerId", "suspension", "vehicle", "provenance", "validation"],
  "properties": {
    "schemaVersion": { "const": "2.0.0" },
    "projectId": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1, "maxLength": 120 },
    "description": { "type": "string", "maxLength": 500 },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "dataClassification": { "enum": ["demonstration", "team_private"] },
    "modelStatus": { "enum": ["demonstration", "unvalidated", "benchmarked", "experimentally_validated"] },
    "units": { "type": "object", "additionalProperties": false, "required": ["length", "angle"], "properties": { "length": { "const": "m" }, "angle": { "const": "rad" } } },
    "coordinateSystem": { "type": "object", "additionalProperties": false, "required": ["handedness", "xAxis", "yAxis", "zAxis"], "properties": { "handedness": { "const": "right" }, "xAxis": { "const": "forward" }, "yAxis": { "const": "left" }, "zAxis": { "const": "up" } } },
    "activeCornerId": { "$ref": "#/$defs/cornerId" },
    "suspension": { "$ref": "#/$defs/suspension" },
    "vehicle": {
      "type": "object", "additionalProperties": false, "required": ["wheelbaseM", "frontTrackM", "rearTrackM", "cgPositionM", "massProperties", "corners"],
      "properties": {
        "wheelbaseM": { "type": "number", "exclusiveMinimum": 0 }, "frontTrackM": { "type": "number", "exclusiveMinimum": 0 }, "rearTrackM": { "type": "number", "exclusiveMinimum": 0 }, "cgPositionM": { "$ref": "#/$defs/vec3" },
        "massProperties": { "type": "object", "additionalProperties": false, "required": ["totalMassKg", "sprungMassKg", "rollInertiaKgM2", "pitchInertiaKgM2", "yawInertiaKgM2", "provenanceNote"], "properties": { "totalMassKg": { "$ref": "#/$defs/nullablePositive" }, "sprungMassKg": { "$ref": "#/$defs/nullablePositive" }, "rollInertiaKgM2": { "$ref": "#/$defs/nullablePositive" }, "pitchInertiaKgM2": { "$ref": "#/$defs/nullablePositive" }, "yawInertiaKgM2": { "$ref": "#/$defs/nullablePositive" }, "provenanceNote": { "type": "string", "minLength": 1, "maxLength": 500 } } },
        "corners": { "type": "object", "additionalProperties": false, "required": ["front_left", "front_right", "rear_left", "rear_right"], "properties": { "front_left": { "$ref": "#/$defs/vehicleCorner" }, "front_right": { "$ref": "#/$defs/vehicleCorner" }, "rear_left": { "$ref": "#/$defs/vehicleCorner" }, "rear_right": { "$ref": "#/$defs/vehicleCorner" } } }
      }
    },
    "provenance": { "type": "object", "additionalProperties": false, "required": ["sourceLabel"], "properties": { "sourceLabel": { "type": "string", "minLength": 1, "maxLength": 300 }, "migratedFromSchemaVersion": { "type": "string" }, "migrationNote": { "type": "string", "maxLength": 500 } } },
    "validation": { "type": "object", "additionalProperties": false, "required": ["numerical", "reference", "physical", "engineeringApproval", "evidence"], "properties": { "numerical": { "enum": ["VERIFIED_NUMERICALLY", "PARTIALLY_VERIFIED", "UNVERIFIED"] }, "reference": { "enum": ["REFERENCE_BENCHMARKED", "PARTIALLY_BENCHMARKED", "NOT_BENCHMARKED"] }, "physical": { "const": "UNVALIDATED_PHYSICALLY" }, "engineeringApproval": { "const": "NOT_APPROVED" }, "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } } } },
    "parameterManifest": { "$ref": "#/$defs/parameterManifest" },
    "verification": { "$ref": "#/$defs/independentVerification" }
  },
  "$defs": {
    "cornerId": { "enum": ["front_left", "front_right", "rear_left", "rear_right"] },
    "nullablePositive": { "type": ["number", "null"], "exclusiveMinimum": 0 },
    "vec3": { "type": "object", "additionalProperties": false, "required": ["x", "y", "z"], "properties": { "x": { "type": "number" }, "y": { "type": "number" }, "z": { "type": "number" } } },
    "hardpoint": { "type": "object", "additionalProperties": false, "required": ["id", "label", "group", "position"], "properties": { "id": { "type": "string", "minLength": 1 }, "label": { "type": "string", "minLength": 1 }, "group": { "enum": ["upper_wishbone", "lower_wishbone", "steering", "upright", "wheel"] }, "position": { "$ref": "#/$defs/vec3" } } },
    "actuation": {
      "type": "object", "additionalProperties": false, "required": ["type", "uprightPickup", "rockerPushrodPickup", "rockerSpringPickup", "rockerAxisStart", "rockerAxisEnd", "springChassisPickup", "springFreeLengthM", "springRateNPerM"],
      "properties": { "type": { "enum": ["pushrod", "pullrod"] }, "uprightPickup": { "$ref": "#/$defs/vec3" }, "rockerPushrodPickup": { "$ref": "#/$defs/vec3" }, "rockerSpringPickup": { "$ref": "#/$defs/vec3" }, "rockerAxisStart": { "$ref": "#/$defs/vec3" }, "rockerAxisEnd": { "$ref": "#/$defs/vec3" }, "springChassisPickup": { "$ref": "#/$defs/vec3" }, "springFreeLengthM": { "type": "number", "exclusiveMinimum": 0 }, "springRateNPerM": { "type": "number", "exclusiveMinimum": 0 }, "springPreloadN": { "type": "number", "minimum": 0 }, "minimumLengthM": { "type": "number", "exclusiveMinimum": 0 }, "maximumLengthM": { "type": "number", "exclusiveMinimum": 0 }, "damper": { "type": "object", "additionalProperties": false, "required": ["rockerPickup", "chassisPickup", "compressionCoefficientNsPerM", "reboundCoefficientNsPerM"], "properties": { "rockerPickup": { "$ref": "#/$defs/vec3" }, "chassisPickup": { "$ref": "#/$defs/vec3" }, "compressionCoefficientNsPerM": { "type": "number", "minimum": 0 }, "reboundCoefficientNsPerM": { "type": "number", "minimum": 0 } } } }
    },
    "suspension": {
      "type": "object", "additionalProperties": false, "required": ["type", "corner", "hardpoints", "wheel"],
      "properties": {
        "type": { "const": "double_wishbone" },
        "corner": { "$ref": "#/$defs/cornerId" },
        "hardpoints": { "type": "array", "minItems": 9, "maxItems": 9, "items": { "$ref": "#/$defs/hardpoint" } },
        "wheel": {
          "type": "object", "additionalProperties": false, "required": ["radius", "width", "staticCamberRad", "staticToeRad"],
          "properties": { "radius": { "type": "number", "exclusiveMinimum": 0 }, "width": { "type": "number", "exclusiveMinimum": 0 }, "staticCamberRad": { "type": "number", "minimum": -0.35, "maximum": 0.35 }, "staticToeRad": { "type": "number", "minimum": -0.35, "maximum": 0.35 } }
        },
        "actuation": { "$ref": "#/$defs/actuation" }
      }
    },
    "vehicleCorner": { "type": "object", "additionalProperties": false, "required": ["id", "label", "geometrySource", "provenanceNote", "suspension"], "properties": { "id": { "$ref": "#/$defs/cornerId" }, "label": { "type": "string", "minLength": 1 }, "geometrySource": { "enum": ["independent", "mirrored_assumption", "synthetic_demo"] }, "derivedFrom": { "$ref": "#/$defs/cornerId" }, "provenanceNote": { "type": "string", "minLength": 1, "maxLength": 500 }, "suspension": { "$ref": "#/$defs/suspension" } } },
    "evidence": { "type": "object", "additionalProperties": false, "required": ["id", "kind", "title", "source", "recordedAt", "status", "notes"], "properties": { "id": { "type": "string", "minLength": 1 }, "kind": { "enum": ["numerical_benchmark", "cad_comparison", "physical_measurement", "input_provenance"] }, "title": { "type": "string", "minLength": 1, "maxLength": 160 }, "source": { "type": "string", "minLength": 1, "maxLength": 300 }, "recordedAt": { "type": "string", "format": "date-time" }, "status": { "enum": ["pending_review", "accepted", "rejected"] }, "notes": { "type": "string", "maxLength": 1000 } } },
    "independentEvidence": { "type": "object", "additionalProperties": false, "required": ["id", "kind", "title", "source", "reviewStatus", "notes"], "properties": { "id": { "type": "string", "minLength": 1 }, "kind": { "enum": ["input_declaration", "numerical_benchmark", "reference_benchmark", "physical_correlation"] }, "title": { "type": "string", "minLength": 1 }, "source": { "type": "string", "minLength": 1 }, "recordedAt": { "type": ["string", "null"], "format": "date-time" }, "reviewStatus": { "enum": ["pending_review", "accepted", "rejected"] }, "notes": { "type": "string" }, "artifactSha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" } } },
    "independentVerification": { "type": "object", "additionalProperties": false, "required": ["declared", "numerical", "reference", "physical", "evidence"], "properties": { "declared": { "$ref": "#/$defs/declaredAxis" }, "numerical": { "$ref": "#/$defs/numericalAxis" }, "reference": { "$ref": "#/$defs/referenceAxis" }, "physical": { "$ref": "#/$defs/physicalAxis" }, "evidence": { "type": "array", "items": { "$ref": "#/$defs/independentEvidence" } } } },
    "declaredAxis": { "type": "object", "additionalProperties": false, "required": ["status", "evidenceIds"], "properties": { "status": { "enum": ["DECLARED", "NOT_DECLARED"] }, "evidenceIds": { "type": "array", "items": { "type": "string" } } } },
    "numericalAxis": { "type": "object", "additionalProperties": false, "required": ["status", "evidenceIds"], "properties": { "status": { "enum": ["VERIFIED_NUMERICALLY", "PARTIALLY_VERIFIED", "UNVERIFIED", "FAILED"] }, "evidenceIds": { "type": "array", "items": { "type": "string" } } } },
    "referenceAxis": { "type": "object", "additionalProperties": false, "required": ["status", "evidenceIds"], "properties": { "status": { "enum": ["REFERENCE_BENCHMARKED", "PARTIALLY_BENCHMARKED", "NOT_BENCHMARKED"] }, "evidenceIds": { "type": "array", "items": { "type": "string" } } } },
    "physicalAxis": { "type": "object", "additionalProperties": false, "required": ["status", "evidenceIds"], "properties": { "status": { "enum": ["PHYSICALLY_CORRELATED", "PARTIALLY_CORRELATED", "UNVALIDATED_PHYSICALLY"] }, "evidenceIds": { "type": "array", "items": { "type": "string" } } } },
    "parameterManifest": { "type": "object", "additionalProperties": false, "required": ["schemaVersion", "manifestId", "revision", "vehicleId", "configurationId", "configurationLabel", "createdAt", "updatedAt", "parameters", "verification"], "properties": { "schemaVersion": { "const": "1.0.0" }, "manifestId": { "type": "string", "minLength": 1 }, "revision": { "type": "integer", "minimum": 1 }, "vehicleId": { "type": "string", "minLength": 1 }, "configurationId": { "type": "string", "minLength": 1 }, "configurationLabel": { "type": "string", "minLength": 1 }, "createdAt": { "type": "string", "format": "date-time" }, "updatedAt": { "type": "string", "format": "date-time" }, "parameters": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/parameterRecord" } }, "verification": { "$ref": "#/$defs/independentVerification" } } },
    "parameterRecord": { "type": "object", "additionalProperties": false, "required": ["key", "value", "unit", "measurementStatus", "source", "applicableModules", "evidenceIds"], "properties": { "key": { "type": "string", "minLength": 1 }, "value": { "oneOf": [{ "type": "number" }, { "type": "array", "minItems": 1, "items": { "type": "number" } }] }, "unit": { "type": "string", "minLength": 1 }, "measurementStatus": { "enum": ["SYNTHETIC", "DECLARED_UNMEASURED", "MEASURED", "DERIVED_FROM_MEASURED"] }, "source": { "type": "object", "additionalProperties": false, "required": ["kind", "label", "notes"], "properties": { "kind": { "enum": ["synthetic_assumption", "cad", "physical_measurement", "manufacturer_data", "derived", "legacy_import"] }, "label": { "type": "string", "minLength": 1 }, "reference": { "type": ["string", "null"] }, "recordedAt": { "type": ["string", "null"], "format": "date-time" }, "notes": { "type": "string" } } }, "applicableModules": { "type": "array", "minItems": 1, "items": { "enum": ["geometry", "kinematics", "quasi_static", "quarter_car", "full_car_7dof", "bicycle", "optimization"] } }, "uncertainty": { "type": ["object", "null"], "additionalProperties": false, "required": ["value", "unit", "kind"], "properties": { "value": { "type": "number", "minimum": 0 }, "unit": { "type": "string", "minLength": 1 }, "kind": { "enum": ["standard", "expanded", "bound"] }, "coverageFactor": { "type": ["number", "null"], "exclusiveMinimum": 0 }, "confidence": { "type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 1 } } }, "evidenceIds": { "type": "array", "items": { "type": "string" } } } }
  }
}
