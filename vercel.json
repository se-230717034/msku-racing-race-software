{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "apps/web/dist",
  "functions": {
    "api/**/*.py": {
      "maxDuration": 60,
      "excludeFiles": "{.git/**,.github/**,.python/**,.venv/**,apps/**,docs/**,images/**,node_modules/**,packages/contracts/**,packages/engineering/tests/**,services/ansys_bridge/**,services/api/tests/**,**/__pycache__/**,**/*.pyc,playwright-report/**,test-results/**,package-lock.json,README.md,PROGRESS.md,docker-compose.yml,tsconfig.base.json}"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
